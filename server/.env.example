# GuardAI scanner API
PORT=3001
SCANNER_VERSION=0.1.0

# Comma-separated browser origins allowed to read API responses.
# CORS is not authentication.
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Dedicated GuardAI Supabase project only.
# Do not point GuardAI at the existing multi-application Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server/worker-only PostgreSQL connection for GuardAI persistence.
# Never expose this value through VITE_* or browser code.
# Exact direct/session/transaction-pooler URL is selected for the deployment.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Separate worker/scheduler process settings.
# Security requests currently have a 10 s fetch timeout, so a 60 s lease leaves margin.
WORKER_LEASE_SECONDS=60
WORKER_POLL_MS=2000

# Persistent Asset ingestion is intentionally disabled until the selected S3 adapter,
# backend lockfile and staging IAM/lifecycle/isolation gates are complete.
ASSET_PIPELINE_ENABLED=false
GUARDAI_ASSET_MAX_BYTES=10485760
GUARDAI_ASSET_UPLOAD_TTL_SECONDS=900
GUARDAI_ASSET_MAX_EXTRACTED_TEXT_CHARS=100000
GUARDAI_ASSET_PARSER_TIMEOUT_SECONDS=30
GUARDAI_ASSET_WORKER_LEASE_SECONDS=120
# Unix sockets are local/private process boundaries; do not expose clamd over public TCP.
GUARDAI_CLAMD_SOCKET=/run/guardai/clamd.sock
GUARDAI_CLAMD_TIMEOUT_MS=30000
GUARDAI_ASSET_PARSER_SOCKET=/run/guardai/asset-parser.sock
GUARDAI_ASSET_PARSER_TIMEOUT_MS=30000
# AWS/S3 credentials and bucket values are deliberately not defined yet. Add them only
# together with the reviewed S3 adapter and reproducible backend lockfile.

# Billing is disabled until an explicit Stripe environment is configured.
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET to the frontend.
BILLING_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Server-side mapping only. Do not accept Stripe Price IDs from browser input.
# Example shape after real GuardAI commercial plans are approved:
# STRIPE_PLAN_PRICE_MAP_JSON={"pro":"price_..."}
STRIPE_PLAN_PRICE_MAP_JSON={}

# Public contact capture remains off until a real Privacy Notice exists and retention is approved.
LEAD_CAPTURE_ENABLED=false
LEAD_PRIVACY_NOTICE_VERSION=
LEAD_RETENTION_DAYS=0
# Current source deliberately keeps marketing unavailable until a real Double-Opt-In mail flow exists.
LEAD_MARKETING_OPT_IN_ENABLED=false
LEAD_MARKETING_CONSENT_VERSION=
LEAD_MARKETING_CONFIRM_TTL_HOURS=24

# Optional GitHub App integration. Leave all four empty to disable it.
# The private PEM is base64-encoded only for environment transport; it is decoded in process memory.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=

# Legacy synchronous prototype endpoints are disabled by default because they do not
# use persistent organization/target ownership verification. Enable only in controlled
# local development while the frontend is migrated to the authenticated persistent flow.
ALLOW_PROTOTYPE_SCAN_ENDPOINTS=false

# Optional for Security-only scans; required for the current legacy/prototype AI paths.
# Persistent Privacy/Accessibility are evidence-first browser modules, not Gemini fallbacks.
GEMINI_API_KEY=replace_with_server_side_key
GEMINI_MODEL=gemini-2.5-flash

# FAIL-SAFE DEFAULT: false.
# Keep this false for any public/shared environment until GuardAI has real
# authentication, server-side entitlements and durable usage quotas.
# Set true only for controlled local development when you intentionally accept
# unauthenticated Gemini usage/costs.
ALLOW_UNAUTHENTICATED_AI_SCANS=false
