# GuardAI scanner API
PORT=3001

# Comma-separated browser origins allowed to read API responses.
# CORS is not authentication.
CORS_ORIGIN=http://localhost:5173

# Dedicated GuardAI Supabase project only.
# Do not point GuardAI at the existing multi-application Supabase project.
# The publishable key is used by the backend only to validate bearer tokens
# through the Supabase Auth user endpoint until local JWKS verification is added.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional for Security-only scans; required for the current AI-assisted
# Privacy, AI-Governance and document text screening paths.
GEMINI_API_KEY=replace_with_server_side_key
GEMINI_MODEL=gemini-2.5-flash

# FAIL-SAFE DEFAULT: false.
# Keep this false for any public/shared environment until GuardAI has real
# authentication, server-side entitlements and durable usage quotas.
# Set true only for controlled local development when you intentionally accept
# unauthenticated Gemini usage/costs.
ALLOW_UNAUTHENTICATED_AI_SCANS=false
