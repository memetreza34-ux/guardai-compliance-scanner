{
  "name": "guardai-scanner-server",
  "version": "0.1.0",
  "private": true,
  "description": "GuardAI technical screening API prototype under production rebuild",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "worker:security": "node workers/securityWorkerProcess.js",
    "worker:security:once": "node workers/securityWorkerProcess.js --once",
    "worker:repository": "node workers/repositoryWorkerProcess.js",
    "worker:repository:once": "node workers/repositoryWorkerProcess.js --once",
    "scheduler:monitor": "node workers/monitorSchedulerProcess.js",
    "scheduler:monitor:once": "node workers/monitorSchedulerProcess.js --once",
    "parser:asset:sandbox": "node workers/parserSandboxProcess.js",
    "check": "node scripts/checkSource.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@google/genai": "2.15.0",
    "axios": "1.19.0",
    "cheerio": "1.2.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "multer": "2.2.0",
    "pdf-parse": "2.4.5",
    "pg": "8.22.0",
    "stripe": "22.1.1",
    "zod": "4.4.3"
  }
}
