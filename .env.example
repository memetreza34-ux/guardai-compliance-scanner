# GuardAI frontend development configuration
# Never place server secrets in VITE_* variables. Values bundled into the frontend are public.

VITE_API_BASE_URL=http://localhost:3001

# Dedicated GuardAI Supabase project only. These values are intentionally public client config.
# Do NOT use the unrelated existing multi-application Supabase project.
# Do NOT place sb_secret_*, service_role, database passwords or JWT signing secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
